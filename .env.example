# Amy Brain Map 다중 사용자 서비스 환경 변수
# 실제 값은 Vercel Environment Variables에만 등록하고 이 파일이나 GitHub에 저장하지 마세요.

# 관리형 PostgreSQL (예: Neon Console의 pooled connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Google OAuth 웹 애플리케이션
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
NEXT_PUBLIC_APP_URL=https://your-production-domain.example
# 32자 이상 서로 다른 무작위 값. 세션 서명에 사용됩니다.
AUTH_SESSION_SECRET=replace-with-a-long-random-session-secret

# Google Cloud Storage: 비공개 버킷과 버킷 전용 서비스 계정
GCS_BUCKET_NAME=amy-brain-map-prod-your-unique-suffix
# 서비스 계정 JSON 키 파일 전체 내용을 유효한 한 줄 JSON 또는 붙여넣은 JSON으로 등록합니다.
GCS_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id"}
# GCS에 저장하기 전 백업·내보내기 JSON을 AES-256-GCM으로 암호화합니다.
# 최소 32자 무작위 문자열 또는 64자리 16진수입니다. 세션 비밀값과 절대 재사용하지 마세요.
HISTORY_BACKUP_ENCRYPTION_KEY=replace-with-a-long-random-backup-secret

# AI 답변 및 발견 후보 분석
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here

# 선택 사항: 대화창의 웹 검색을 켜고 개인 기록에 근거가 없을 때만 사용합니다.
TAVILY_API_KEY=tvly-your-api-key-here
