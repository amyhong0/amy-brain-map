# AI 답변 및 발견 후보 분석
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here

# 개인 방문 기록 보호
# 최소 32자의 충분히 무작위인 값을 사용하세요. 확장 프로그램과 대시보드의 개인 보호 키로도 사용됩니다.
BROWSER_HISTORY_INGEST_TOKEN=replace-with-a-long-random-secret
# Vercel Blob을 사용할 경우, 32바이트 키를 64자리 16진수로 설정하세요.
BROWSER_HISTORY_ENCRYPTION_KEY=replace-with-64-hex-characters

# 선택 사항: 대화창에서 웹 검색 토글을 켜고, 개인 방문 기록에 근거가 없을 때만 사용합니다.
TAVILY_API_KEY=tvly-your-api-key-here

# 기존 인증 기능을 사용하는 경우에만 필요합니다.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# 실제 키는 배포 환경 변수에만 등록하고, .env 파일은 절대 저장소에 올리지 마세요.
