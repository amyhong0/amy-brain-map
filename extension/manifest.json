{
  "manifest_version": 3,
  "name": "Amy Brain Map — Unconscious Map",
  "version": "0.5.0",
  "description": "개인 방문 메타데이터를 Amy Brain Map에 안전하게 동기화해 나만의 사고 지도를 만듭니다.",
  "permissions": ["history", "storage", "alarms", "scripting"],
  "host_permissions": ["http://localhost/*", "https://*.vercel.app/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Amy Brain Map 동기화",
    "default_popup": "src/popup.html"
  },
  "options_page": "src/options.html"
}
